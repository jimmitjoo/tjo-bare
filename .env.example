APP_NAME=myapp
APP_URL=http://localhost:4000

# you probably want to set this to false in production
DEBUG=true

# the port our application should be served on
PORT=4000

# the server name, e.g. www.mysite.com
SERVER_NAME=localhost

# do you want to use https? Probably in production.
SECURE=false

# database config - we currently support mysql and postgres
DATABASE_TYPE=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASS=
DATABASE_NAME=
DATABASE_SSL_MODE=

# redis config
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=myapp

CACHE=

# cookie settings
COOKIE_NAME=myapp
COOKIE_LIFETIME=1440
COOKIE_PERSIST=true
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

SESSION_TYPE=cookie

# SMTP mail settings
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=2525
SMTP_ENCRYPTION=tls

# mail settings
MAIL_DOMAIN=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# mail settings for mailer service
MAILER_API=
MAILER_KEY=
MAILER_URL=

# rendering engine
RENDERER=jet

# encryption key
KEY=

# CORS - comma-separated allowed origins (empty = block all cross-origin requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Amazon S3
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# Minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET=password
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=testbucket

# SMS settings
SMS_PROVIDER=

# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=