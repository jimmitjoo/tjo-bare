<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}" class="min-h-screen">
<head>
        <meta charset="UTF-8">
        <meta name="csrf_token" content="{{.CSRFToken}}">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{{yield browserTitle()}}</title>

        <link rel="icon" type="image/png" sizes="32x32" href="/public/ico/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/public/ico/favicon-16x16.png">
        <link rel="apple-touch-icon" href="/public/ico/apple-touch-icon.png">
        <link rel="manifest" href="/public/ico/site.webmanifest">

        <link href="/public/css/styles.css" rel="stylesheet">

      {{yield css()}}
</head>
<body class="min-h-screen bg-gray-50">
<div class="container mx-auto">
            {{if .Flash }}
                <div class="flex items-center justify-between gap-x-6 bg-gray-900 py-2.5 px-6 sm:pe-3.5 lg:ps-8">
                    <p class="text-sm leading-6 text-white">
                        {{.Flash}}
                    </p>
                </div>
            {{end}}

            {{if .Error }}
                <div class="flex items-center justify-between gap-x-6 bg-red-700 py-2.5 px-6 sm:pe-3.5 lg:ps-8">
                    <p class="text-sm leading-6 text-white">
                        {{.Error}}
                    </p>
                </div>
            {{end}}
            
            {{yield pageContent()}} 
        </div>
</div>
{{yield js()}} 
</body>
</html>