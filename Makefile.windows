BINARY_NAME=tjoApp.exe

build:
	@echo "Building Tjo..."
	@go build -o tmp/${BINARY_NAME} .
	@npm install
	@npm run build
	@echo "Tjo built!"

run: build start_compose
	@echo "Starting Tjo..."
	@start /min cmd /c tmp\${BINARY_NAME} &
	@npm run watch
	@echo "Tjo started!"

clean:
	@echo "Cleaning..."
	@DEL ${BINARY_NAME}
	@go clean
	@echo "Cleaned!"

start_compose:
	docker-compose up -d

stop_compose:
	docker-compose down

test:
	@echo "Testing..."
	@go test ./...
	@echo "Done!"

start: run

dev: run

stop:
	@echo "Stopping Tjo..."
	@taskkill /IM ${BINARY_NAME} /F
	@echo "Stopped Tjo!"

restart: stop start